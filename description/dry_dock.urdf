<robot name="dry_dock">
  <link name="Beckholmen"/>          <!-- world anchor -->
  <link name="dry_dock_mesh">
    <visual>
      <geometry>
        <mesh filename="package://dead_reckoning/description/beckholmen_boatless.dae"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_dock" type="fixed">
    <parent link="Beckholmen"/>
    <child link="dry_dock_mesh"/>
    <origin xyz="0 0 1.35" rpy="0 0 0"/>
  </joint>
</robot>
